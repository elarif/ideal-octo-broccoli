---
interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const { src, width, height, alt, loading = "lazy", fetchpriority = "auto", class: cls = "" } = Astro.props;
---
<img
  src={src}
  width={width}
  height={height}
  alt={alt}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class={`w-full h-auto ${cls}`}
/>
