---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import BookList from "../../../components/BookList.astro";

export async function getStaticPaths() {
  const licences = await getCollection("licences");
  return licences.map((licence) => ({ params: { slug: licence.data.slug } }));
}

const { slug } = Astro.params;
const licence = await getCollection("licences").then((all) => all.find((l) => l.data.slug === slug));
if (!licence) throw new Error(`Licence not found: ${slug}`);

const allBooks = await getCollection("books");
const books = allBooks.filter((b) => b.data.licences.some((l) => l.slug === slug));
books.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, Number(pageParam) || 1);
---

<Base
  title={`Livres audio ${licence.data.name} | Litteratureaudio.com`}
  description={`Écoutez et téléchargez gratuitement les livres audio ${licence.data.name}.`}
>
  <BookList
    books={books}
    title={`Livres audio ${licence.data.name}`}
    currentPage={currentPage}
    pageSize={24}
    baseUrl={`/livre-audio-gratuit-mp3/licence/${slug}.html`}
  />
</Base>
