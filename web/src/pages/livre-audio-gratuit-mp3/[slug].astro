---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { TrackList } from "../../components/Player/TrackList";
import { formatDuration } from "../../lib/format-duration";
import { formatViews } from "../../lib/format-views";
import { pageUrl } from "../../lib/urls";
import { toAudioBook } from "../../lib/audio-book";
import Section from "../../components/ui/Section.astro";
import CompactBookCard from "../../components/CompactBookCard.astro";
import { ZipDownloadButton } from "../../components/ZipDownloadButton";
import CommentsPlaceholder from "../../components/CommentsPlaceholder.astro";
import Button from "../../components/ui/Button.astro";
import { Download } from "lucide-react";

export async function getStaticPaths() {
  const books = await getCollection("books");
  return books.map((book) => ({
    params: { slug: book.data.slug },
    props: { book, allBooks: books },
  }));
}

const { book, allBooks } = Astro.props;
const d = book.data;
const authorsLabel = d.authors.map((a) => a.name).join(", ");
const voicesLabel = d.voices.map((v) => v.name).join(", ");
const genresLabel = d.genres.map((g) => g.name).join(", ");
const periodsLabel = d.periods.map((p) => p.name).join(", ");
const regionsLabel = d.regions.map((r) => r.name).join(", ");
const licencesLabel = d.licences.map((l) => l.name).join(", ");

const audioBook = toAudioBook(book);

const voiceSlugs = d.voices.map((v) => v.slug);
const sameVoiceBooks = allBooks
  .filter((b) => b.data.slug !== d.slug && b.data.voices.some((v) => voiceSlugs.includes(v.slug)))
  .sort((a, b) => b.data.views - a.data.views)
  .slice(0, 6);

const topBooks = allBooks
  .filter((b) => b.data.slug !== d.slug)
  .sort((a, b) => b.data.views - a.data.views)
  .slice(0, 6);

const authorSlug = d.authors[0]?.slug;
async function loadAuthorPortrait(slug: string) {
  const all = await getCollection("authors");
  const entry = all.find((a) => a.data.slug === slug);
  return entry?.data.portrait;
}
const authorPortrait = authorSlug ? await loadAuthorPortrait(authorSlug) : undefined;

const isSelection = d.tracks.length === 0 && d.content && d.content.includes("block-loop");
let selectionSlugs: string[] = [];
let descriptionHtml = d.content;
if (isSelection) {
  const slugSet = new Set<string>();
  const matches = d.content.matchAll(/\/livre-audio-gratuit-mp3\/([a-z0-9-]+)\.html/g);
  for (const m of matches) slugSet.add(m[1]);
  selectionSlugs = [...slugSet];
  descriptionHtml = d.content.split('<div style="" class="wp-block-loop')[0];
}
const selectionBooks = isSelection
  ? allBooks.filter((b) => selectionSlugs.includes(b.data.slug))
  : [];
---

<Base
  title={`${d.title} | Litteratureaudio.com`}
  description={d.excerpt || `Livre audio gratuit ${d.title} de ${authorsLabel}.`}
  canonical={d.legacyUrl}
  image={d.cover?.url}
>
  <article>
    <header class="flex flex-col md:flex-row gap-6 mb-8">
      {d.cover && (
        <div class="md:w-1/3 max-w-xs">
          <img
            src={d.cover.url}
            width={d.cover.width}
            height={d.cover.height}
            alt={d.cover.alt || d.title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-auto rounded shadow-lg object-cover aspect-[3/4]"
          />
        </div>
      )}
      <div class="flex-1">
        <h1 class="text-3xl font-bold mb-2">{d.title}</h1>
        {authorsLabel && (
          <p class="mb-1">
            De {d.authors.map((a, i) => (
              <Fragment><a href={pageUrl(`/livre-audio-gratuit-mp3/auteur/${a.slug}`)} class="text-primary hover:underline">{a.name}</a>{i < d.authors.length - 1 ? ", " : ""}</Fragment>
            ))}
          </p>
        )}
        {voicesLabel && (
          <p class="mb-1">
            Lu par {d.voices.map((v, i) => (
              <Fragment><a href={pageUrl(`/livre-audio-gratuit-mp3/voix/${v.slug}`)} class="text-primary hover:underline">{v.name}</a>{i < d.voices.length - 1 ? ", " : ""}</Fragment>
            ))}
          </p>
        )}
        <p class="mb-1">Durée : {formatDuration(d.durationTotal)}</p>
        <p class="mb-1">Ajouté le : {new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" }).format(new Date(d.publishedAt))}</p>
        {d.views > 0 && <p class="mb-1 text-gray-600">{formatViews(d.views)} écoutes</p>}
        {d.likeCount > 0 && <p class="mb-1 text-gray-600">{d.likeCount} j'aime</p>}
        {genresLabel && (
          <p class="mb-1">
            Genre : {d.genres.map((g, i) => (
              <Fragment><a href={pageUrl(`/livre-audio-gratuit-mp3/genre/${g.slug}`)} class="text-primary hover:underline">{g.name}</a>{i < d.genres.length - 1 ? ", " : ""}</Fragment>
            ))}
          </p>
        )}
        {periodsLabel && <p class="mb-1">Période : {periodsLabel}</p>}
        {regionsLabel && <p class="mb-1">Région : {regionsLabel}</p>}
        {licencesLabel && <p class="mb-1">Licence : {licencesLabel}</p>}
        {d.commentCount > 0 && <p class="mb-1 text-gray-600">{d.commentCount} commentaire{d.commentCount > 1 ? "s" : ""}</p>}
        {authorPortrait && (
          <div class="mt-4 flex items-start gap-3">
            <img src={authorPortrait.url} alt={authorPortrait.alt} class="w-20 h-24 object-cover rounded shadow" loading="lazy" decoding="async" />
            <div>
              <p class="text-sm font-medium">{d.authors[0]?.name}</p>
              <p class="text-xs text-gray-500">{authorPortrait.alt}</p>
            </div>
          </div>
        )}
      </div>
    </header>

    {d.tracks.length > 0 && (
      <Section title="Écouter / Télécharger">
        <div class="flex flex-wrap gap-3 mb-4">
          <ZipDownloadButton client:visible title={d.title} tracks={audioBook.tracks.map((t) => ({ title: t.title, url: t.url }))} />
          {d.downloadUrl && (
            <Button href={d.downloadUrl} variant="ghost">
              <span class="inline-flex items-center gap-2">
                <Download size={18} />
                Télécharger le MP3
              </span>
            </Button>
          )}
          {d.textUrl && (
            <Button href={d.textUrl} variant="link">Consulter la version texte →</Button>
          )}
        </div>
        <TrackList client:load book={audioBook} />
      </Section>
    )}

    {isSelection && selectionBooks.length > 0 && (
      <Section title="Livres audio de cette sélection">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {selectionBooks.map((b) => <CompactBookCard book={b} />)}
        </div>
      </Section>
    )}

    {isSelection && selectionSlugs.length > selectionBooks.length && (
      <Section title="Autres livres de cette sélection">
        <p class="text-gray-600 text-sm mb-3">Ces livres ne sont pas encore disponibles dans notre catalogue. Retrouvez-les sur le site original :</p>
        <ul class="space-y-1">
          {selectionSlugs.filter((s) => !selectionBooks.some((b) => b.data.slug === s)).map((s) => (
            <li><a href={`https://www.litteratureaudio.com/livre-audio-gratuit-mp3/${s}.html`} class="text-primary hover:underline" rel="noopener">{s.replace(/-/g, " ")}</a></li>
          ))}
        </ul>
      </Section>
    )}

    {descriptionHtml && (
      <Section title="Description">
        <div class="prose max-w-none" set:html={descriptionHtml} />
      </Section>
    )}

    {sameVoiceBooks.length > 0 && voicesLabel && (
      <Section title={`Lu par ${voicesLabel}`}>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {sameVoiceBooks.map((b) => <CompactBookCard book={b} />)}
        </div>
      </Section>
    )}

    {topBooks.length > 0 && (
      <Section title="Les plus écoutés ❤️">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {topBooks.map((b) => <CompactBookCard book={b} />)}
        </div>
      </Section>
    )}

    <CommentsPlaceholder count={d.commentCount} />
  </article>
</Base>