---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import BookList from "../../../components/BookList.astro";

export async function getStaticPaths() {
  const regions = await getCollection("regions");
  return regions.map((region) => ({ params: { slug: region.data.slug } }));
}

const { slug } = Astro.params;
const region = await getCollection("regions").then((all) => all.find((r) => r.data.slug === slug));
if (!region) throw new Error(`Region not found: ${slug}`);

const allBooks = await getCollection("books");
const books = allBooks.filter((b) => b.data.regions.some((r) => r.slug === slug));
books.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, Number(pageParam) || 1);
---

<Base
  title={`Livres audio ${region.data.name} | Litteratureaudio.com`}
  description={`Écoutez et téléchargez gratuitement les livres audio ${region.data.name}.`}
>
  <BookList
    books={books}
    title={`Livres audio ${region.data.name}`}
    currentPage={currentPage}
    pageSize={24}
    baseUrl={`/livre-audio-gratuit-mp3/region/${slug}.html`}
  />
</Base>
