---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const genres = await getCollection("genres");
  return genres.map((genre) => ({ params: { slug: genre.data.slug } }));
}

return Astro.redirect(`/livre-audio-gratuit-mp3/genre/${Astro.params.slug}/1.html`);
